#!/usr/bin/env bash
set -euo pipefail

if [[ -n "$(git tag --merged HEAD --list)" ]]; then
	mise exec -- cog check --from-latest-tag
	exit
fi

mapfile -t root_commits < <(git rev-list --max-parents=0 HEAD)
if [[ "${#root_commits[@]}" -ne 1 ]]; then
	printf 'expected one initial root commit, found %s\n' "${#root_commits[@]}" >&2
	exit 1
fi

root_commit="${root_commits[0]}"
mapfile -t commits < <(git rev-list --reverse --topo-order HEAD)
if [[ "${commits[0]}" != "$root_commit" ]]; then
	printf 'history does not begin at the expected root commit\n' >&2
	exit 1
fi
if [[ "${#commits[@]}" -eq 1 ]]; then
	printf 'no commits after initial root commit\n'
	exit 0
fi

for commit in "${commits[@]:1}"; do
	mise exec -- cog check "$commit..$commit"
done
