{
  "$schema": "https://docs.renovatebot.com/renovate-global-schema.json",
  "allowedCommands": [
    "^common-repo apply$",
    "^script/renovate-update-spec$"
  ],
  "automerge": false,
  "customDatasources": {
    "devin-openapi": {
      "defaultRegistryUrlTemplate": "file://.renovate/openapi-source.yaml",
      "format": "yaml",
      "transformTemplates": [
        "{\"releases\":[{\"version\":version,\"digest\":digest}]}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "git-tags",
      "depTypeTemplate": "common-repo",
      "description": "common-repo upstream refs, url before ref",
      "managerFilePatterns": [
        "/(^|/)\\.common-repo\\.ya?ml$/"
      ],
      "matchStrings": [
        "url:[ \\t]*[\"']?https://github\\.com/(?<depName>[^/\\s\"'#]+/[^/\\s\"'#]+?)(?:\\.git)?[\"']?[ \\t]*(?:#[^\\n]*)?\\n(?:[ \\t]*(?:#[^\\n]*)?\\n)*[ \\t]*ref:[ \\t]*[\"']?(?<currentValue>[^\\s\"'#]+)"
      ],
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "git-tags",
      "depTypeTemplate": "common-repo",
      "description": "common-repo upstream refs, ref before url",
      "managerFilePatterns": [
        "/(^|/)\\.common-repo\\.ya?ml$/"
      ],
      "matchStrings": [
        "ref:[ \\t]*[\"']?(?<currentValue>[^\\s\"'#]+)[\"']?[ \\t]*(?:#[^\\n]*)?\\n(?:[ \\t]*(?:#[^\\n]*)?\\n)*[ \\t]*url:[ \\t]*[\"']?https://github\\.com/(?<depName>[^/\\s\"'#]+/[^/\\s\"'#]+?)(?:\\.git)?[\"']?[ \\t]*(?:#[^\\n]*)?(?:\\n|$)"
      ],
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "custom.devin-openapi",
      "depNameTemplate": "devin-openapi-spec",
      "depTypeTemplate": "openapi-spec",
      "description": "Devin OpenAPI SHA-256 digest",
      "managerFilePatterns": [
        "/\\.renovate\\/openapi-source\\.yaml$/"
      ],
      "matchStrings": [
        "version:[ \\t]*(?<currentValue>1\\.0\\.0)[ \\t]*\\n[ \\t]*digest:[ \\t]*(?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "versioningTemplate": "semver-coerced"
    }
  ],
  "enabledManagers": [
    "custom.regex"
  ],
  "onboarding": false,
  "packageRules": [
    {
      "matchDepTypes": [
        "common-repo"
      ],
      "postUpgradeTasks": {
        "commands": [
          "common-repo apply"
        ],
        "fileFilters": [
          "**/*"
        ]
      }
    },
    {
      "constraints": {
        "golang": "1.26.11"
      },
      "matchDepTypes": [
        "openapi-spec"
      ],
      "postUpgradeTasks": {
        "commands": [
          "script/renovate-update-spec"
        ],
        "fileFilters": [
          ".renovate/openapi-source.yaml",
          "v3-openapi.yaml",
          "codegen/v3-openapi.normalized.yaml",
          "client.gen.go",
          "types.gen.go"
        ],
        "installTools": {
          "golang": {}
        }
      }
    }
  ],
  "requireConfig": "optional"
}
